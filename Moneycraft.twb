      <aliases enabled='yes' />
      <column caption='LTV to CAC ratio' datatype='real' name='[Calculation_5126569433157632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([value_12m]) / AVG([CAC])' />
      </column>
      <column caption='Profitability' datatype='string' name='[Calculation_5126569435631619]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([value_12m]) / AVG([CAC]) &lt; 1 THEN &quot;Loses Money&quot;&#10;ELSEIF AVG([value_12m]) / AVG([CAC]) &gt;= 2 THEN &quot;Strong Return&quot;&#10;ELSE &quot;Is Profitable&quot;&#10;END' />
      </column>
      <column caption='First-year profit per customer (£)' datatype='real' name='[Calculation_5126569449152516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG ([value_12m]) - AVG([CAC])' />
      </column>
      <column caption='Profitability by Channel' datatype='string' name='[Calculation_5350594956234753]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([value_12m]) - AVG([CAC]) &lt; 0 THEN &quot;Loses Money&quot;&#10;ELSEIF AVG([value_12m]) - AVG([CAC]) &gt;= 50 THEN &quot;Strong Return&quot;&#10;ELSE &quot;Is Profitable&quot;&#10;END' />
      </column>
